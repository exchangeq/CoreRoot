<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/console_title"
        style="@style/SectionTitle"
        android:textSize="22sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:hintTextColor="@color/accent"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/console_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/console_hint"
            android:inputType="textMultiLine"
            android:fontFamily="monospace" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/console_run"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/console_run"
            app:backgroundTint="@color/accent"
            android:textColor="@color/brand_ink" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/console_clear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:text="@string/console_clear" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/brand_deep"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:contentPadding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/console_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:text="@string/console_output" />
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
